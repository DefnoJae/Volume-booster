{
  "id": "SeaBoost",
  "name": "SeaBoost",
  "version": "0.2.1",
  "manifestURI": "https://raw.githubusercontent.com/DefnoJae/Volume-booster/refs/heads/main/Manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Extends Seanime's native volume control beyond 100% with a configurable maximum boost.",
  "author": "Jae",
  "icon": "https://raw.githubusercontent.com/DefnoJae/Volume-booster/refs/heads/main/assets/iccon.png",
  "website": "https://github.com/DefnoJae/Volume-booster",
  "readme": "https://github.com/DefnoJae/Volume-booster/blob/main/README.md",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/DefnoJae/Volume-booster/refs/heads/main/src/SeaBoost.js",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "storage"
      ]
    }
  },
  "isDevelopment": false,
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "maxVolume",
        "label": "Maximum volume",
        "default": "300",
        "options": [
          {
            "value": "150",
            "label": "150%"
          },
          {
            "value": "200",
            "label": "200%"
          },
          {
            "value": "250",
            "label": "250%"
          },
          {
            "value": "300",
            "label": "300%"
          },
          {
            "value": "400",
            "label": "400%"
          },
          {
            "value": "500",
            "label": "500%"
          }
        ]
      }
    ]
  }
}
